---
const steps = [
  { n: "01", name: "Discovery", desc: "We dig into who you are, what you stand for, and what the world around you needs. Clarity starts with listening." },
  { n: "02", name: "Strategy", desc: "We turn insight into direction: a purpose, a position, and a story that gives every decision a reason." },
  { n: "03", name: "Activation", desc: "We bring the brand to life across identity, design, and experience, then set it loose to grow." },
];
---
<section class="method" id="method" data-method>
  <div class="method-inner">
    <span class="label">/How We Work</span>
    <div class="method-stage">
      <div class="method-orbit" aria-hidden="true">
        <svg viewBox="0 0 200 200" class="orbit-svg">
          <circle cx="100" cy="100" r="86" class="orbit-ring" />
          <circle cx="100" cy="14"  r="11" class="orbit-dot" data-dot="0" />
          <circle cx="174.5" cy="143" r="11" class="orbit-dot" data-dot="1" />
          <circle cx="25.5" cy="143" r="11" class="orbit-dot" data-dot="2" />
          <text x="100" y="14"   class="orbit-label" data-dotlabel="0">1</text>
          <text x="174.5" y="143" class="orbit-label" data-dotlabel="1">2</text>
          <text x="25.5" y="143"  class="orbit-label" data-dotlabel="2">3</text>
        </svg>
      </div>
      <div class="method-copy">
        {steps.map((s, i) => (
          <div class="mcopy" data-mcopy data-index={i}>
            <span class="mcopy-num">{s.n}</span>
            <h3 class="mcopy-name">{s.name}</h3>
            <p class="mcopy-desc">{s.desc}</p>
          </div>
        ))}
      </div>
    </div>
    <div class="method-scrollzones" data-mzones>
      <div class="mzone" data-mzone="0"></div>
      <div class="mzone" data-mzone="1"></div>
      <div class="mzone" data-mzone="2"></div>
    </div>
  </div>
</section>
