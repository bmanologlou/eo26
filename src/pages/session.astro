---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const CAL_LINK = "https://cal.com/eternaloptimists/";

const steps = [
  { n: "01", title: "Book a time", desc: "Pick a slot that works for you. It takes a minute, and you'll get a confirmation with everything you need." },
  { n: "02", title: "We talk", desc: "A focused 30-minute conversation about your brand, your challenge, and where you want to go. No slides, no pitch." },
  { n: "03", title: "You leave with direction", desc: "Clear, honest thoughts on your next steps, whether or not we end up working together." },
];

const forWho = [
  "Founders shaping a brand from the ground up",
  "Businesses whose brand no longer fits where they're headed",
  "Teams planning a rebrand, a website, or a bigger move",
  "Anyone who senses their brand could be working harder",
  "People who just want a clear, outside perspective",
];

const benefits = [
  { title: "Clarity on where you stand", desc: "An honest read on your brand today, what's working, what's holding it back, and what deserves your attention first." },
  { title: "A sense of direction", desc: "Concrete, practical next steps you can act on, whether that's alongside us or entirely on your own." },
  { title: "Room to think out loud", desc: "A calm, no-pressure space to talk through the questions you haven't had time to sit with." },
];
---

<Base title="Book a Session — Eternal Optimists" description="A free 30-minute conversation about your brand and where you want to take it. No pitch, just honest direction.">
  <Header />

  <main class="ses">
    <section class="ses-hero">
      <span class="label scroll-reveal">/Book a Session</span>
      <h1 class="ses-title scroll-reveal">A conversation about<br><em>where you're headed.</em></h1>
      <p class="ses-lead scroll-reveal">Every good brand starts with a good conversation. Book a free 30-minute session and we'll talk through your brand, your challenge, and the clearest way forward. No pitch, no obligation, just honest thinking from people who do this every day.</p>
      <a href={CAL_LINK} target="_blank" rel="noopener" class="btn-fill ses-cta scroll-reveal">
        Book your session
        <svg viewBox="0 0 24 24"><path d="M7 17L17 7M17 7H8M17 7v9"/></svg>
      </a>
      <span class="ses-note scroll-reveal">Free · Up to 30 minutes · Online</span>
    </section>

    <section class="ses-block ses-host">
      <span class="label scroll-reveal">/Who You'll Talk To</span>
      <p class="ses-block-intro scroll-reveal">You'll be talking with me, not a sales team. Here's how I think about it.</p>
      <div class="ses-host-row scroll-reveal">
        <div class="ses-host-photo">
          <img src="/assets/session/babis.webp" alt="Babis Manologlou, Founder of Eternal Optimists" />
        </div>
        <div class="ses-host-text">
          <p class="ses-host-quote">"Most brands don't have a visibility problem, they have a clarity problem. Get clear on what you stand for, and everything else gets easier. That's what I love talking through, and it's where every good brand starts."</p>
          <div class="ses-host-name">Babis Manologlou</div>
          <div class="ses-host-role">Founder & Strategist, Eternal Optimists</div>
        </div>
      </div>
    </section>

    <section class="ses-block">
      <span class="label scroll-reveal">/How It Works</span>
      <div class="ses-steps" data-stagger>
        {steps.map((s) => (
          <div class="ses-step reveal-item">
            <span class="ses-step-num">{s.n}</span>
            <h3 class="ses-step-title">{s.title}</h3>
            <p class="ses-step-desc">{s.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="ses-block ses-benefits">
      <span class="label scroll-reveal">/What You'll Get</span>
      <p class="ses-block-intro scroll-reveal">Half an hour, and something to show for it. You won't get a sales pitch, you'll get real thinking about your brand and a clearer idea of where to take it next.</p>
      <div class="ses-benefit-grid" data-stagger>
        {benefits.map((b) => (
          <div class="ses-benefit reveal-item">
            <h3 class="ses-benefit-title">{b.title}</h3>
            <p class="ses-benefit-desc">{b.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="ses-block">
      <span class="label scroll-reveal">/Who It's For</span>
      <p class="ses-block-intro scroll-reveal">A session is for anyone with a brand on their mind, wherever they are in the journey. You don't need a brief, a budget, or even a firm plan. If any of these sound like you, it's worth a conversation.</p>
      <ul class="ses-for" data-stagger>
        {forWho.map((f) => <li class="reveal-item">{f}</li>)}
      </ul>
    </section>

    <section class="ses-final">
      <h2 class="scroll-reveal">Ready when you are.</h2>
      <p class="ses-final-sub scroll-reveal">Grab a slot and let's talk. Worst case, you leave with a clearer head.</p>
      <a href={CAL_LINK} target="_blank" rel="noopener" class="btn-fill ses-cta scroll-reveal">
        Book your session
        <svg viewBox="0 0 24 24"><path d="M7 17L17 7M17 7H8M17 7v9"/></svg>
      </a>
    </section>
  </main>

  <Footer />
  <script is:inline defer src="/main.js"></script>
</Base>
