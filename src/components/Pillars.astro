---
const pillars = [
  { name: "Foundation", slug: "foundation", desc: "The purpose, values, and truth a brand is built on. Everything else stands on this." },
  { name: "Strategy", slug: "strategy", desc: "Positioning, narrative, and direction. How the brand competes and why it matters." },
  { name: "Identity", slug: "identity", desc: "The name, voice, and personality that make a brand recognisably itself." },
  { name: "Design", slug: "design", desc: "The visual system, from logo to typography to art direction, that makes it real." },
  { name: "Experience", slug: "experience", desc: "Every touchpoint, digital and physical, where people meet and remember the brand." },
  { name: "Growth", slug: "growth", desc: "Content, campaigns, and systems that keep the brand moving and expanding." },
];
---
<section class="pillars">
  <div class="pillars-head">
    <span class="label">/What A Brand Needs</span>
    <h2>Six pillars that carry a brand from idea to impact.</h2>
    <p>Not every brand needs all six at once. We work across them as your brand grows, from first foundation to lasting momentum.</p>
  </div>
  <div class="pillars-list" data-stagger>
    {pillars.map((p) => (
      <div class="pillar reveal-item">
        <h3 class="pillar-name">{p.name}</h3>
        <p class="pillar-desc">{p.desc}</p>
        <a class="text-link pillar-link" href={`/approach/${p.slug}`}>Explore
          <svg viewBox="0 0 24 24"><path d="M7 17L17 7M17 7H8M17 7v9"/></svg>
        </a>
      </div>
    ))}
  </div>
</section>
