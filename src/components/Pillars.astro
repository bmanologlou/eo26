---
const pillars = [
  { n: "01", name: "Foundation", slug: "foundation", desc: "The purpose, values, and truth a brand is built on. Everything else stands on this." },
  { n: "02", name: "Strategy", slug: "strategy", desc: "Positioning, narrative, and direction. How the brand competes and why it matters." },
  { n: "03", name: "Identity", slug: "identity", desc: "The name, voice, and personality that make a brand recognisably itself." },
  { n: "04", name: "Design", slug: "design", desc: "The visual system, from logo to typography to art direction, that makes it real." },
  { n: "05", name: "Experience", slug: "experience", desc: "Every touchpoint, digital and physical, where people meet and remember the brand." },
  { n: "06", name: "Growth", slug: "growth", desc: "Content, campaigns, and systems that keep the brand moving and expanding." },
];
---
<section class="pillars">
  <div class="pillars-head">
    <span class="label">/What A Brand Needs</span>
    <h2>Six pillars that carry a brand from idea to impact.</h2>
    <p>Not every brand needs all six at once. We work across them as your brand grows, from first foundation to lasting momentum.</p>
  </div>
  <div class="pillars-list" data-stagger>
    {pillars.map((p) => (
      <a class="pillar reveal-item" href={`/approach/${p.slug}`}>
        <span class="pillar-num">{p.n}</span>
        <div class="pillar-body">
          <h3 class="pillar-name">{p.name}</h3>
          <p class="pillar-desc">{p.desc}</p>
        </div>
        <span class="pillar-arrow" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="M7 17L17 7M17 7H8M17 7v9"/></svg>
        </span>
      </a>
    ))}
  </div>
</section>
