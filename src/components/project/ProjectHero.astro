---
const { title, subtitle, intro, tags = [], bg = "#1414BE", fg = "#ffffff" } = Astro.props;
const shown = tags.slice(0, 2);
---
<section class="pj-hero" style={`background:${bg};color:${fg};`}>
  <div class="pj-hero-inner">
    <span class="label pj-eyebrow" style={`color:${fg};opacity:.6;`}>/Project</span>
    <h1 class="pj-title">{title}</h1>
    {subtitle && <p class="pj-subtitle">{subtitle}</p>}
    {intro && <p class="pj-intro">{intro}</p>}
    {shown.length > 0 && (
      <ul class="pj-tags">
        {shown.map((t) => (
          <li><a class="pj-tag" href={`/work?filter=${encodeURIComponent(t)}`} data-astro-reload style={`border-color:${fg};color:${fg};`}>{t}</a></li>
        ))}
      </ul>
    )}
  </div>
</section>
