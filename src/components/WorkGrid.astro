---
const projects = [
  { name: "SleepnLife", desc: "Brand refresh and digital presence for a better night's rest.", cat: "Identity", img: "/assets/work/sleepnlife.webp", slug: "#", ratio: "4 / 5" },
  { name: "EduPaths", desc: "A learning platform brand built for clarity and growth.", cat: "Strategy", img: "/assets/work/edupaths.webp", slug: "#", ratio: "3 / 4" },
  { name: "Groowise", desc: "Positioning and identity for a data-driven consultancy.", cat: "Strategy", img: "/assets/work/groowise.webp", slug: "#", ratio: "1 / 1" },
  { name: "Project Four", desc: "Visual system and art direction for a modern retailer.", cat: "Design", img: "/assets/work/sleepnlife.webp", slug: "#", ratio: "4 / 5" },
  { name: "Project Five", desc: "End-to-end brand experience for a hospitality group.", cat: "Experience", img: "/assets/work/edupaths.webp", slug: "#", ratio: "1 / 1" },
  { name: "Project Six", desc: "Naming, identity, and packaging for a food label.", cat: "Identity", img: "/assets/work/groowise.webp", slug: "#", ratio: "3 / 4" },
  { name: "Project Seven", desc: "Strategy and messaging for a fintech launch.", cat: "Strategy", img: "/assets/work/sleepnlife.webp", slug: "#", ratio: "4 / 5" },
  { name: "Project Eight", desc: "Design system for a scaling software product.", cat: "Design", img: "/assets/work/edupaths.webp", slug: "#", ratio: "1 / 1" },
  { name: "Project Nine", desc: "Brand world and campaign for a cultural festival.", cat: "Experience", img: "/assets/work/groowise.webp", slug: "#", ratio: "4 / 5" },
  { name: "Project Ten", desc: "Identity and guidelines for a wellness studio.", cat: "Identity", img: "/assets/work/sleepnlife.webp", slug: "#", ratio: "3 / 4" },
  { name: "Project Eleven", desc: "Positioning and website for a design consultancy.", cat: "Strategy", img: "/assets/work/edupaths.webp", slug: "#", ratio: "1 / 1" },
  { name: "Project Twelve", desc: "Art direction and packaging for a beverage brand.", cat: "Design", img: "/assets/work/groowise.webp", slug: "#", ratio: "4 / 5" },
  { name: "Project Thirteen", desc: "Experience design for a flagship retail space.", cat: "Experience", img: "/assets/work/sleepnlife.webp", slug: "#", ratio: "3 / 4" },
  { name: "Project Fourteen", desc: "Complete rebrand for a legacy manufacturer.", cat: "Identity", img: "/assets/work/edupaths.webp", slug: "#", ratio: "1 / 1" },
];
const filters = ["All", "Strategy", "Identity", "Design", "Experience"];
const withIdx = projects.map((p, i) => ({ ...p, idx: i }));
const left = withIdx.filter((_, i) => i % 2 === 0);
const right = withIdx.filter((_, i) => i % 2 === 1);
---
<section class="workgrid">
  <div class="workgrid-head">
    <span class="label">/Selected Work</span>
    <div class="workgrid-filters">
      {filters.map((f, i) => (
        <button class={`wg-filter${i === 0 ? " active" : ""}`} data-filter={f}>{f}</button>
      ))}
    </div>
  </div>
  <div class="workgrid-cols" id="workgridGrid">
    <div class="wg-col">
      {left.map((p) => (
        <a href={p.slug} class="wg-card" data-cat={p.cat} data-idx={p.idx}>
          <div class="wg-thumb" style={`aspect-ratio:${p.ratio}`}><img src={p.img} alt={p.name} loading="lazy" /></div>
          <div class="wg-meta">
            <h3 class="wg-name">{p.name}</h3>
            <p class="wg-desc">{p.desc}</p>
          </div>
        </a>
      ))}
    </div>
    <div class="wg-col wg-col-offset">
      {right.map((p) => (
        <a href={p.slug} class="wg-card" data-cat={p.cat} data-idx={p.idx}>
          <div class="wg-thumb" style={`aspect-ratio:${p.ratio}`}><img src={p.img} alt={p.name} loading="lazy" /></div>
          <div class="wg-meta">
            <h3 class="wg-name">{p.name}</h3>
            <p class="wg-desc">{p.desc}</p>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
