---
const traits = [
  {
    name: "Curious",
    desc: "We never stop asking questions. Curiosity is how we find what others miss.",
    shape: `<circle cx="20" cy="20" r="20" fill="var(--blue)"/>`,
  },
  {
    name: "Strategic",
    desc: "Every creative decision starts with clear thinking and a reason behind it.",
    shape: `<rect x="0" y="0" width="40" height="40" rx="6" fill="var(--blue)"/>`,
  },
  {
    name: "Optimistic",
    desc: "We believe in what a brand can become, and build toward that possibility.",
    shape: `<path d="M20 0 L40 40 L0 40 Z" fill="var(--blue)"/>`,
  },
  {
    name: "Relentless",
    desc: "We push until the work is right, not just until it is done.",
    shape: `<path d="M20 0 L40 20 L20 40 L0 20 Z" fill="var(--blue)"/>`,
  },
  {
    name: "Lorem",
    desc: "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor.",
    shape: `<path d="M20 1 L37.3 11 L37.3 31 L20 41 L2.7 31 L2.7 11 Z" transform="translate(0,-1)" fill="var(--blue)"/>`,
  },
  {
    name: "Ipsum",
    desc: "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor.",
    shape: `<path d="M20 0 L25 15 L40 20 L25 25 L20 40 L15 25 L0 20 L15 15 Z" fill="var(--blue)"/>`,
  },
];
---
<section class="traits">
  <div class="traits-head">
    <span class="label">/What Defines Us</span>
    <h2>The things that show up in everything we do.</h2>
  </div>
  <div class="traits-list" data-stagger>
    {traits.map((t) => (
      <div class="trait reveal-item">
        <span class="trait-icon" aria-hidden="true">
          <svg viewBox="0 0 40 40" set:html={t.shape}></svg>
        </span>
        <div class="trait-body">
          <h3 class="trait-name">{t.name}</h3>
          <p class="trait-desc">{t.desc}</p>
        </div>
      </div>
    ))}
  </div>
</section>
