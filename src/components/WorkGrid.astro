---
const projects = [
  { name: "SleepnLife", desc: "Brand refresh and digital presence for a better night's rest.", cat: "Identity", img: "/assets/work/sleepnlife.webp", slug: "#" },
  { name: "EduPaths", desc: "A learning platform brand built for clarity and growth.", cat: "Strategy", img: "/assets/work/edupaths.webp", slug: "#" },
  { name: "Groowise", desc: "Positioning and identity for a data-driven consultancy.", cat: "Strategy", img: "/assets/work/groowise.webp", slug: "#" },
  { name: "Project Four", desc: "Visual system and art direction for a modern retailer.", cat: "Design", img: "/assets/work/sleepnlife.webp", slug: "#" },
  { name: "Project Five", desc: "End-to-end brand experience for a hospitality group.", cat: "Experience", img: "/assets/work/edupaths.webp", slug: "#" },
  { name: "Project Six", desc: "Naming, identity, and packaging for a food label.", cat: "Identity", img: "/assets/work/groowise.webp", slug: "#" },
  { name: "Project Seven", desc: "Strategy and messaging for a fintech launch.", cat: "Strategy", img: "/assets/work/sleepnlife.webp", slug: "#" },
  { name: "Project Eight", desc: "Design system for a scaling software product.", cat: "Design", img: "/assets/work/edupaths.webp", slug: "#" },
  { name: "Project Nine", desc: "Brand world and campaign for a cultural festival.", cat: "Experience", img: "/assets/work/groowise.webp", slug: "#" },
  { name: "Project Ten", desc: "Identity and guidelines for a wellness studio.", cat: "Identity", img: "/assets/work/sleepnlife.webp", slug: "#" },
  { name: "Project Eleven", desc: "Positioning and website for a design consultancy.", cat: "Strategy", img: "/assets/work/edupaths.webp", slug: "#" },
  { name: "Project Twelve", desc: "Art direction and packaging for a beverage brand.", cat: "Design", img: "/assets/work/groowise.webp", slug: "#" },
  { name: "Project Thirteen", desc: "Experience design for a flagship retail space.", cat: "Experience", img: "/assets/work/sleepnlife.webp", slug: "#" },
  { name: "Project Fourteen", desc: "Complete rebrand for a legacy manufacturer.", cat: "Identity", img: "/assets/work/edupaths.webp", slug: "#" },
];
const filters = ["All", "Strategy", "Identity", "Design", "Experience"];
---
<section class="workgrid">
  <div class="workgrid-head">
    <span class="label">/Selected Work</span>
    <div class="workgrid-filters">
      {filters.map((f, i) => (
        <button class={`wg-filter${i === 0 ? " active" : ""}`} data-filter={f}>{f}</button>
      ))}
    </div>
  </div>
  <div class="workgrid-grid" id="workgridGrid">
    {projects.map((p) => (
      <a href={p.slug} class="wg-card" data-cat={p.cat}>
        <div class="wg-thumb"><img src={p.img} alt={p.name} loading="lazy" /></div>
        <div class="wg-meta">
          <h3 class="wg-name">{p.name}</h3>
          <p class="wg-desc">{p.desc}</p>
        </div>
      </a>
    ))}
  </div>
</section>
