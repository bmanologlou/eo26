---
// split: "equal" | "left-wide" | "right-wide"
const { title, left, right, split = "equal" } = Astro.props;
const cols = split === "left-wide" ? "3fr 2fr"
          : split === "right-wide" ? "2fr 3fr"
          : "1fr 1fr";
---
<section class="pj-block">
  <div class="pj-inner">
    {title && <h3 class="pj-block-title">{title}</h3>}
    <div class="pj-twoup" style={`grid-template-columns:${cols};`}>
      <figure class="pj-fig">
        {left?.src ? <img src={left.src} alt={left.alt || ""} /> : <div class="pj-ph"><span>Image</span></div>}
        {left?.caption && <figcaption class="pj-cap">{left.caption}</figcaption>}
      </figure>
      <figure class="pj-fig">
        {right?.src ? <img src={right.src} alt={right.alt || ""} /> : <div class="pj-ph"><span>Image</span></div>}
        {right?.caption && <figcaption class="pj-cap">{right.caption}</figcaption>}
      </figure>
    </div>
  </div>
</section>
