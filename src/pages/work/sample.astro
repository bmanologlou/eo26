---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ProjectHero from '../../components/project/ProjectHero.astro';
import ProjectHeroImage from '../../components/project/ProjectHeroImage.astro';
import ProjectOverview from '../../components/project/ProjectOverview.astro';
import ProjectImage from '../../components/project/ProjectImage.astro';
import ProjectTwoUp from '../../components/project/ProjectTwoUp.astro';
import ProjectStatement from '../../components/project/ProjectStatement.astro';
import ProjectImageText from '../../components/project/ProjectImageText.astro';
import ProjectVideo from '../../components/project/ProjectVideo.astro';
import ProjectTextBlock from '../../components/project/ProjectTextBlock.astro';
import ProjectSlider from '../../components/project/ProjectSlider.astro';
import ProjectNext from '../../components/project/ProjectNext.astro';
---

<Base title="SleepnLife — Eternal Optimists" description="A sleep brand reframed around the morning.">
  <Header />

  <main class="pj">
  <ProjectHero
    title="SleepnLife"
    subtitle="A sleep brand reframed around the morning, not the night."
    intro="SleepnLife came to us with a simple product and a crowded category. We rebuilt the brand around a single, optimistic idea — that good sleep is really about the day it makes possible."
    tags={["Strategy", "Identity", "Design", "Art Direction"]}
    bg="#1414BE"
    fg="#ffffff"
  />

  <ProjectHeroImage flush />

  <ProjectOverview
    heading="From a product about night, to a brand about mornings."
    body="We led strategy, positioning and a complete visual identity. The work reframed the category, moving the story away from the bed and toward everything a well-rested day makes possible — from the tagline to a full visual language."
    services={["Strategy", "Identity", "Design", "Art Direction"]}
  />

  <ProjectImage title="Identity" caption="The primary logotype and mark." />

  <ProjectTwoUp
    left={{ caption: "Colour system" }}
    right={{ caption: "Typographic scale" }}
    split="equal"
  />

  <ProjectStatement text="Rest, reframed as a good day waiting to happen." />

  <ProjectTwoUp
    title="Applications"
    left={{}}
    right={{}}
    split="left-wide"
  />

  <ProjectTwoUp
    title="Reversed split"
    left={{}}
    right={{}}
    split="right-wide"
  />

  <ProjectImageText
    layout="image-left"
    title="A system, not just a look."
    body="We built a flexible identity that works across every touchpoint — from packaging to app to storefront — without losing its character."
    caption="Brand system in use."
  />

  <ProjectImageText
    layout="image-right"
    title="Built to flex."
    body="The same core elements rearrange to fit any format, so the brand always feels like itself wherever it shows up."
  />

  <ProjectSlider title="Process" />

  <ProjectVideo title="In motion" />

  <ProjectTextBlock
    eyebrow="Outcome"
    title="A brand that finally matched the ambition behind it."
    body="The relaunch gave SleepnLife a clear, ownable position and a visual language the whole team could build on — and it reframed how the category talks about rest."
  />

  <ProjectImage caption="Packaging system across the range." />

  <ProjectHeroImage />

  <ProjectNext name="EduPaths" />
  </main>

  <Footer />
  <script is:inline defer src="/main.js"></script>
</Base>
