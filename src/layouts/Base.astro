---
// Base layout — head, meta, favicon, and the full site stylesheet.
import { ViewTransitions } from 'astro:transitions';
const {
  title = "Eternal Optimists — Independent Brand Studio",
  description = "An independent brand studio building fearless brands with clarity and conviction.",
} = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href="https://eo26.eoflux.com/">
<meta name="robots" content="index, follow">

<!-- Open Graph -->
<meta property="og:type" content="website">
<meta property="og:site_name" content="Eternal Optimists">
<meta property="og:title" content="Eternal Optimists — Independent Brand Studio">
<meta property="og:description" content="An independent brand studio building fearless brands with clarity and conviction.">
<meta property="og:url" content="https://eo26.eoflux.com/">
<meta property="og:image" content="https://eo26.eoflux.com/og-image.png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:locale" content="en">

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="Eternal Optimists — Independent Brand Studio">
<meta name="twitter:description" content="An independent brand studio building fearless brands with clarity and conviction.">
<meta name="twitter:image" content="https://eo26.eoflux.com/og-image.png">

<!-- Structured data for search + AI agents -->
<script type="application/ld+json" is:inline>
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Eternal Optimists",
  "alternateName": "EO",
  "url": "https://eo26.eoflux.com/",
  "logo": "https://eo26.eoflux.com/favicon.svg",
  "image": "https://eo26.eoflux.com/og-image.png",
  "description": "Eternal Optimists is an independent brand studio. An independent brand studio building fearless brands with clarity and conviction.",
  "slogan": "Imagine Fearless",
  "address": {
    "@type": "PostalAddress",
    "addressCountry": "GR"
  },
  "sameAs": [
    "https://www.instagram.com/eternaloptimistsagency/",
    "https://www.linkedin.com/company/eternaloptimists/",
    "https://www.behance.net/EternalOptimists"
  ],
  "knowsAbout": ["Brand Strategy", "Brand Identity", "Design", "Brand Experience"]
}
</script>

<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<ViewTransitions />
<script is:inline>
  // runs in <head> before body paints: mark arriving project transition so the dot starts white (no flash)
  try{
    if(sessionStorage.getItem('pjNextColor')){
      document.documentElement.setAttribute('data-arriving','1');
    }
  }catch(e){}
</script>
<style is:global>
  /* local variable fonts */
  @font-face{
    font-family:'Clash Display';
    src:url('/assets/fonts/ClashDisplay-Variable.woff2') format('woff2');
    font-weight:400 700;font-style:normal;font-display:swap;
  }
  @font-face{
    font-family:'Erode';
    src:url('/assets/fonts/Erode-Variable.woff2') format('woff2');
    font-weight:400 700;font-style:normal;font-display:swap;
  }
  @font-face{
    font-family:'Switzer';
    src:url('/assets/fonts/Switzer-Variable.woff2') format('woff2');
    font-weight:300 800;font-style:normal;font-display:swap;
  }
  :root{
    --blue:#1414BE;
    --ink:#0c0c12;
    --paper:#ffffff;
    --paper-2:#f6f5f2;
    --line:rgba(12,12,18,.12);
    --muted:#6a6a72;
    --maxw:1280px;
    --measure-wide:1000px;
    --measure-text:850px;
    --section-gap:84px;
    --gutter:clamp(20px,5vw,64px);
  }
  *{margin:0;padding:0;box-sizing:border-box;}
  html{
    scroll-behavior:smooth;
    scrollbar-width:thin;
    scrollbar-color:rgba(12,12,18,.28) transparent;
  }
  /* WebKit browsers */
  ::-webkit-scrollbar{width:8px;height:8px;}
  ::-webkit-scrollbar-track{background:transparent;}
  ::-webkit-scrollbar-thumb{
    background:rgba(12,12,18,.24);border-radius:8px;
    border:2px solid transparent;background-clip:content-box;
  }
  ::-webkit-scrollbar-thumb:hover{background:rgba(12,12,18,.4);background-clip:content-box;}
  @media(max-width:720px){
    html{scrollbar-width:none;}
    ::-webkit-scrollbar{width:0;height:0;display:none;}
  }

  /* ===== SESSION PAGE ===== */
  .ses-hero{
    max-width:var(--maxw);margin:0 auto;padding:clamp(140px,24vh,280px) var(--gutter) clamp(50px,8vh,90px);
  }
  .ses-hero .label{ display:block;margin-bottom:24px; }
  .ses-title{
    font-family:'Clash Display',sans-serif;font-weight:600;
    font-size:clamp(40px,7vw,96px);line-height:1;letter-spacing:-.03em;
    color:var(--ink);margin:0;
  }
  .ses-title em{ font-style:normal;color:var(--blue); }
  .ses-lead{
    font-family:'Erode',serif;font-weight:400;
    font-size:clamp(17px,1.9vw,22px);line-height:1.5;color:#33333a;
    max-width:var(--measure-text);margin:clamp(24px,4vh,36px) 0 0;
  }
  .ses-cta{ margin-top:clamp(28px,4vh,40px);display:inline-flex;align-items:center;gap:10px; }
  .ses-cta svg{ width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round; }
  .ses-note{
    display:block;margin-top:18px;
    font-family:'Switzer',sans-serif;font-weight:500;font-size:14px;color:var(--muted);letter-spacing:.01em;
  }
  .ses-block{
    max-width:var(--maxw);margin:0 auto;padding:clamp(40px,7vh,80px) var(--gutter);
  }
  .ses-block .label{ display:block;margin-bottom:clamp(28px,4vh,44px); }
  .ses-block-intro{
    font-family:'Erode',serif;font-weight:400;
    font-size:clamp(17px,1.9vw,22px);line-height:1.5;color:#28282e;
    max-width:var(--measure-text);margin:0 0 clamp(32px,5vh,52px);
  }
  .ses-benefits{ background:#f6f5f2;border-radius:20px;padding:clamp(36px,5vw,64px) clamp(28px,4vw,56px);margin-top:clamp(20px,4vh,40px);margin-bottom:clamp(20px,4vh,40px); }
  .ses-benefit-grid{
    display:grid;grid-template-columns:repeat(3,1fr);gap:clamp(28px,4vw,56px);
  }
  .ses-benefit-title{
    font-family:'Clash Display',sans-serif;font-weight:600;
    font-size:clamp(19px,2vw,25px);line-height:1.1;letter-spacing:-.02em;
    color:var(--blue);margin:0 0 12px;
  }
  .ses-benefit-desc{
    font-family:'Erode',serif;font-weight:400;
    font-size:clamp(14px,1.5vw,17px);line-height:1.55;color:#33333a;margin:0;
  }
  .ses-steps{
    display:grid;grid-template-columns:repeat(3,1fr);gap:clamp(28px,4vw,56px);
  }
  .ses-step-num{
    font-family:'Switzer',sans-serif;font-weight:600;font-size:13px;
    color:var(--blue);letter-spacing:.04em;
  }
  .ses-step-title{
    font-family:'Clash Display',sans-serif;font-weight:600;
    font-size:clamp(20px,2.2vw,27px);line-height:1.05;letter-spacing:-.02em;
    color:var(--ink);margin:14px 0 12px;
  }
  .ses-step-desc{
    font-family:'Erode',serif;font-weight:400;
    font-size:clamp(14px,1.5vw,17px);line-height:1.55;color:var(--muted);margin:0;
  }
  .ses-for{
    list-style:none;margin:0;padding:0;border-top:1px solid var(--line);
    max-width:var(--measure-wide);
  }
  .ses-for li{
    font-family:'Clash Display',sans-serif;font-weight:500;
    font-size:clamp(18px,2.2vw,28px);letter-spacing:-.01em;color:var(--ink);
    padding:clamp(16px,2.2vh,24px) 0;border-bottom:1px solid var(--line);
  }
  .ses-host-row{
    display:grid;grid-template-columns:minmax(200px,300px) 1fr;
    gap:clamp(28px,5vw,64px);align-items:center;
  }
  .ses-host-photo{ border-radius:16px;overflow:hidden;background:var(--paper-2);aspect-ratio:4/5; }
  .ses-host-photo img{ width:100%;height:100%;object-fit:cover;display:block; }
  .ses-host-quote{
    font-family:'Erode',serif;font-weight:400;font-style:italic;
    font-size:clamp(18px,2.2vw,26px);line-height:1.45;color:var(--ink);
    margin:0 0 22px;max-width:40ch;
  }
  .ses-host-name{
    font-family:'Clash Display',sans-serif;font-weight:600;
    font-size:clamp(17px,1.8vw,21px);letter-spacing:-.01em;color:var(--ink);
  }
  .ses-host-role{
    font-family:'Switzer',sans-serif;font-weight:500;font-size:14px;color:var(--muted);margin-top:4px;
  }
  @media(max-width:680px){
    .ses-host-row{ grid-template-columns:1fr;gap:24px; }
    .ses-host-photo{ max-width:none;width:100%;aspect-ratio:4/5;border-radius:16px; }
  }
  .ses-final{
    max-width:var(--maxw);margin:0 auto;padding:clamp(60px,10vh,120px) var(--gutter) clamp(80px,14vh,160px);
    text-align:center;
  }
  .ses-final h2{
    font-family:'Clash Display',sans-serif;font-weight:600;
    font-size:clamp(34px,5.5vw,72px);line-height:1;letter-spacing:-.03em;
    color:var(--ink);margin:0;
  }
  .ses-final-sub{
    font-family:'Erode',serif;font-weight:400;
    font-size:clamp(16px,1.8vw,21px);line-height:1.5;color:#33333a;
    margin:20px auto 0;max-width:44ch;
  }
  .ses-final .ses-cta{ margin-top:clamp(28px,4vh,40px); }
  @media(max-width:760px){
    .ses-steps{ grid-template-columns:1fr;gap:36px; }
    .ses-benefit-grid{ grid-template-columns:1fr;gap:28px; }
  }
  .pl{ padding:clamp(120px,20vh,220px) 0 clamp(40px,7vh,90px); }
  .pl-top{
    max-width:var(--maxw);margin:0 auto;padding:0 var(--gutter);
    margin-bottom:clamp(56px,9vh,110px);
    display:grid;grid-template-columns:220px 1fr;gap:clamp(40px,7vw,120px);
  }
  .pl-top-content{ grid-column:2; }
  .pl-top .label{ display:block;margin-bottom:24px; }
  .pl-toptitle{
    font-family:'Clash Display',sans-serif;font-weight:600;
    font-size:clamp(34px,5vw,64px);line-height:1.02;letter-spacing:-.025em;
    color:var(--ink);margin:0;
  }
  .pl-topintro{
    font-family:'Erode',serif;font-weight:400;
    font-size:clamp(16px,1.7vw,20px);line-height:1.55;color:#33333a;
    margin:clamp(20px,3vh,30px) 0 0;max-width:var(--measure-text);
  }
  .pl-inner{
    max-width:var(--maxw);margin:0 auto;padding:0 var(--gutter);
    display:grid;grid-template-columns:220px 1fr;gap:clamp(40px,7vw,120px);align-items:start;
  }
  .pl-nav{ position:sticky;top:110px; }
  .pl-nav .label{ display:block;margin-bottom:18px; }
  .pl-nav ul{ list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:2px; }
  .pl-nav a{
    display:block;padding:8px 0;
    font-family:'Clash Display',sans-serif;font-weight:500;font-size:17px;letter-spacing:-.01em;
    color:var(--muted);transition:color .25s ease;
  }
  .pl-nav a:hover{ color:var(--ink); }
  .pl-nav a.is-current{ color:var(--blue); }
  .pl-body{ max-width:var(--measure-text); }
  .pl-eyebrow{ display:block;margin-bottom:24px; }
  .pl-question{
    font-family:'Clash Display',sans-serif;font-weight:600;
    font-size:clamp(26px,3.4vw,44px);line-height:1.06;letter-spacing:-.025em;
    color:var(--blue);margin:0 0 28px;
  }
  .pl-lead{
    font-family:'Erode',serif;font-weight:400;
    font-size:clamp(17px,1.9vw,22px);line-height:1.5;color:#28282e;margin:0;
  }
  .pl-section{ margin-top:clamp(64px,11vh,130px); }
  .pl-h2{
    font-family:'Switzer',sans-serif;font-weight:600;font-size:13px;letter-spacing:.06em;
    text-transform:uppercase;color:var(--muted);margin:0 0 18px;
  }
  .pl-text{
    font-family:'Erode',serif;font-weight:400;
    font-size:clamp(15px,1.6vw,18px);line-height:1.6;color:#33333a;margin:0;
  }
  .pl-services{ list-style:none;margin:0;padding:0;border-top:1px solid var(--line); }
  .pl-services li{
    font-family:'Clash Display',sans-serif;font-weight:500;
    font-size:clamp(18px,2vw,24px);letter-spacing:-.01em;color:var(--ink);
    padding:16px 0;border-bottom:1px solid var(--line);
  }
  .pl-links{
    display:flex;flex-wrap:wrap;gap:16px 40px;
    margin-top:clamp(44px,7vh,80px);padding-top:clamp(28px,4vh,40px);
    border-top:1px solid var(--line);
  }
  .pl-next{
    display:inline-flex;flex-direction:column;gap:8px;margin-top:clamp(48px,8vh,90px);
    text-decoration:none;
  }
  .pl-next-label{
    font-family:'Switzer',sans-serif;font-weight:600;font-size:12px;letter-spacing:.06em;
    text-transform:uppercase;color:var(--muted);
  }
  .pl-next-row{ display:inline-flex;align-items:center;gap:14px; }
  .pl-next-name{
    font-family:'Clash Display',sans-serif;font-weight:600;
    font-size:clamp(22px,2.6vw,30px);line-height:1;letter-spacing:-.02em;
    color:var(--ink);transition:color .25s ease;
  }
  .pl-next-arrow{
    width:32px;height:32px;border-radius:50%;flex:0 0 auto;
    border:1px solid var(--line);
    display:flex;align-items:center;justify-content:center;
    transition:background .25s ease,border-color .25s ease,transform .25s ease;
  }
  .pl-next-arrow svg{width:14px;height:14px;fill:none;stroke:var(--ink);stroke-width:2;stroke-linecap:round;stroke-linejoin:round;transition:stroke .25s ease;}
  .pl-next:hover .pl-next-name{ color:var(--blue); }
  .pl-next:hover .pl-next-arrow{ background:var(--blue);border-color:var(--blue);transform:translateX(3px); }
  .pl-next:hover .pl-next-arrow svg{ stroke:#fff; }
  @media(max-width:820px){
    .pl-inner{ grid-template-columns:1fr;gap:40px; }
    .pl-top{ grid-template-columns:1fr;gap:0; }
    .pl-top-content{ grid-column:1; }
    .pl-nav{ display:none; }
  }
  /* --pj-edge: header gutter (logo/button inset). text blocks start at column 2 of 12. */
  :root{ --pj-gap:clamp(56px,9vh,120px); --pj-edge:clamp(20px,5vw,64px); --pj-edge-r:max(2px, calc(var(--pj-edge) - 18px)); }
  @media(max-width:720px){ :root{ --pj-edge-r:var(--pj-edge); } }
  .pj{ display:block; }
  .pj > *{ margin:0; }
  .pj > * + *{ margin-top:var(--pj-gap); }
  .pj-heroimg-flush{ margin-top:0 !important; }
  /* contained media: left aligns to logo, right aligns to button border (button sits 18px past header padding) */
  .pj-inner{ width:100%; padding-left:var(--pj-edge); padding-right:var(--pj-edge-r); }
  /* text blocks: start at column 2, end at button border — identical for all */
  .pj-hero-inner,
  .pj-overview,
  .pj-statement-inner,
  .pj-textblock-inner{
    width:100%;
    padding-left:calc(var(--pj-edge) + (100% - var(--pj-edge) - var(--pj-edge-r)) * 2 / 12);
    padding-right:var(--pj-edge-r);
  }
  @media(max-width:760px){
    .pj-hero-inner,.pj-overview,.pj-statement-inner,.pj-textblock-inner{ padding-left:var(--pj-edge); }
  }
  .pj-hero{ width:100%; padding-top:clamp(130px,20vh,210px); padding-bottom:clamp(44px,7vh,88px); }
  .pj-eyebrow{ display:block; margin-bottom:22px; }
  .pj-title{
    font-family:'Clash Display',sans-serif;font-weight:600;
    font-size:clamp(44px,8vw,120px);line-height:.98;letter-spacing:-.03em;margin:0;
  }
  .pj-subtitle{
    font-family:'Clash Display',sans-serif;font-weight:500;
    font-size:clamp(20px,2.6vw,32px);line-height:1.1;letter-spacing:-.02em;
    margin:clamp(20px,3vh,32px) 0 0;max-width:var(--measure-wide);
  }
  .pj-intro{
    font-family:'Erode',serif;font-weight:400;
    font-size:clamp(16px,1.7vw,20px);line-height:1.55;
    margin:clamp(40px,6vh,72px) 0 0;max-width:var(--measure-text);opacity:.92;
  }
  .pj-tags{
    display:flex;flex-wrap:wrap;gap:10px;list-style:none;padding:0;
    margin:clamp(32px,4.5vh,52px) 0 0;
  }
  .pj-tag{
    display:inline-block;text-decoration:none;
    font-family:'Switzer',sans-serif;font-weight:500;font-size:14px;
    border:1px solid currentColor;border-radius:999px;padding:8px 16px;opacity:.9;
    transition:opacity .25s ease;
  }
  .pj-tag:hover{ opacity:1; }
  .pj-tags li{ list-style:none; }
  .pj-tags{
    list-style:none;display:flex;flex-wrap:wrap;gap:8px;padding:0;
    margin:clamp(30px,4.5vh,52px) 0 0;
  }
  .pj-tag{
    font-family:'Switzer',sans-serif;font-weight:500;font-size:14px;
    border:1px solid;border-radius:999px;padding:8px 16px;opacity:.9;
  }
  .pj-fullscreen{ margin:0; width:100%; }
  .pj-fullscreen img, .pj-ph-full{ width:100%; display:block; }
  .pj-fullscreen img{ aspect-ratio:16/10; max-height:88vh; object-fit:cover; }
  .pj-fullscreen picture{ display:block;width:100%; }
  .pj-fullscreen picture img{ width:100%; }
  .pj-ph-full{ aspect-ratio:16/10; max-height:88vh; }
  @media(max-width:760px){
    .pj-fullscreen img,.pj-fullscreen .pj-ph-full{ aspect-ratio:9/16 !important;max-height:none !important; }
  }
  .pj-overview{
    display:grid;grid-template-columns:2fr 1fr;gap:clamp(32px,6vw,90px);
    margin:0 auto;
  }
  .pj-h2{
    font-family:'Clash Display',sans-serif;font-weight:600;
    font-size:clamp(26px,3.4vw,44px);line-height:1.05;letter-spacing:-.025em;margin:0;
  }
  .pj-body{
    font-family:'Erode',serif;font-weight:400;
    font-size:clamp(16px,1.6vw,19px);line-height:1.6;color:#33333a;
    margin:clamp(18px,2.4vh,26px) 0 0;max-width:60ch;
  }
  .pj-services{ list-style:none;margin:0;padding:0; }
  .pj-services li{
    font-family:'Switzer',sans-serif;font-weight:500;font-size:16px;
    padding:6px 0;color:var(--ink);
  }
  .pj-block-title{
    display:block;margin:0 0 20px;
    font-family:'Clash Display',sans-serif;font-weight:500;
    font-size:clamp(16px,1.6vw,20px);line-height:1.1;letter-spacing:-.01em;
    color:var(--ink);
  }
  .pj-fig{ margin:0;width:100%; }
  .pj-fig img{ width:100%;display:block;border-radius:10px; }
  /* single image block (ProjectImage): wide 16/10 */
  .pj-block > .pj-inner > .pj-fig img,
  .pj-block > .pj-inner > .pj-fig .pj-ph{ aspect-ratio:16/10;height:auto;object-fit:cover; }
  .pj-cap{
    font-family:'Switzer',sans-serif;font-weight:500;font-size:13px;
    color:var(--muted);margin-top:12px;
  }
  .pj-twoup{ display:grid;gap:clamp(16px,2vw,28px);align-items:start; }
  .pj-threeup{ display:grid;grid-template-columns:1fr 1fr 1fr;gap:clamp(16px,2vw,28px);align-items:start; }
  .pj-stack{ display:flex;flex-direction:column;gap:clamp(14px,1.6vw,22px); }
  .pj-stack-item img,.pj-stack-item .pj-ph{ aspect-ratio:16/10;height:auto;width:100%;object-fit:cover; }
  /* full-page website block */
  .pj-fullpage-head{ display:flex;align-items:baseline;justify-content:space-between;gap:20px;margin-bottom:22px; }
  .pj-fullpage-head .pj-block-title{ margin:0; }
  .pj-fullpage-toggle{
    background:none;border:none;padding:0;cursor:pointer;
    font-family:'Switzer',sans-serif;font-weight:500;font-size:14px;color:var(--muted);
    display:inline-flex;align-items:center;transition:color .25s ease;
    letter-spacing:.02em;
  }
  .pj-fullpage-toggle:hover{ color:var(--ink); }
  .pj-fullpage-toggle .fp-label-less{ display:none; }
  .pj-fullpage.is-open .pj-fullpage-toggle .fp-label-more{ display:none; }
  .pj-fullpage.is-open .pj-fullpage-toggle .fp-label-less{ display:inline; }
  .pj-fullpage-viewport{
    width:100%;height:80vh;overflow:hidden;border-radius:10px;background:var(--paper-2);
    transition:height 1.05s cubic-bezier(.16,1,.3,1);
  }
  .pj-fullpage-viewport img{ width:100%;display:block;height:auto; }
  .pj-fullpage-ph{
    width:100%;height:180vh;border:1px dashed var(--line);border-radius:10px;
    display:flex;align-items:center;justify-content:center;
    background:repeating-linear-gradient(45deg,#ececef 0 2px,transparent 2px 22px),var(--paper-2);
  }
  .pj-threeup .pj-fig img,.pj-threeup .pj-ph{ aspect-ratio:4/5;height:auto;width:100%;object-fit:cover; }
  @media(max-width:760px){ .pj-threeup{ grid-template-columns:1fr; } }
  .pj-twoup .pj-fig img,
  .pj-twoup .pj-ph{ height:clamp(300px,42vw,540px);width:100%;object-fit:cover; }
  .pj-statement{
    font-family:'Clash Display',sans-serif;font-weight:500;
    font-size:clamp(28px,4.6vw,64px);line-height:1.08;letter-spacing:-.025em;
    margin:0;max-width:var(--measure-wide);color:var(--ink);
  }
  .pj-ph{
    width:100%;aspect-ratio:4/3;display:flex;align-items:center;justify-content:center;
    background:repeating-linear-gradient(45deg,#ececef 0 2px,transparent 2px 22px),var(--paper-2);
    border:1px dashed var(--line);border-radius:10px;
  }
  .pj-ph-full{
    display:flex;align-items:center;justify-content:center;
    background:repeating-linear-gradient(45deg,#e4e4e7 0 2px,transparent 2px 26px),var(--paper-2);
  }
  .pj-ph span,.pj-ph-full span{
    font-family:'Switzer',sans-serif;font-weight:600;font-size:13px;
    letter-spacing:.08em;text-transform:uppercase;color:var(--muted);
  }
  .pj-next{
    display:block;margin-top:var(--pj-gap);position:relative;text-decoration:none;color:#fff;
  }
  .pj-next-img{ width:100%; }
  .pj-next-img img,.pj-next .pj-ph-full{ width:100%;aspect-ratio:16/6;object-fit:cover;display:block;max-height:52vh; }
  .pj-next-inner{
    position:absolute;inset:0;z-index:1;display:flex;flex-direction:column;
    align-items:center;justify-content:center;text-align:center;
    background:rgba(12,12,18,.34);transition:background .3s ease;
  }
  .pj-next:hover .pj-next-inner{ background:rgba(12,12,18,.5); }
  .pj-next-label{
    font-family:'Switzer',sans-serif;font-weight:600;font-size:13px;
    letter-spacing:.08em;text-transform:uppercase;opacity:.85;margin-bottom:12px;
  }
  .pj-next-name{
    font-family:'Clash Display',sans-serif;font-weight:600;
    font-size:clamp(36px,6vw,88px);line-height:1;letter-spacing:-.03em;
  }
  /* color curtain for next-project transition */
  #pj-curtain{
    position:fixed;left:0;right:0;bottom:0;height:0;z-index:9999;
    pointer-events:none;will-change:height;
  }
  #pj-curtain.rising{ height:100vh;transition:height .55s cubic-bezier(.7,0,.25,1); }
  #pj-curtain.falling{ height:0;transition:height .5s cubic-bezier(.7,0,.25,1); }
  @media(max-width:760px){
    .pj-overview{ grid-template-columns:1fr;gap:32px; }
    .pj-twoup{ grid-template-columns:1fr!important;gap:16px; }
  }

  /* Image + text side by side */
  .pj-imagetext-grid{ display:grid;grid-template-columns:1fr 1fr;gap:clamp(28px,5vw,72px);align-items:center; }
  .pj-imagetext.is-right .pj-imagetext-media{ order:2; }
  .pj-imagetext-media img,.pj-imagetext-media .pj-ph{ aspect-ratio:4/5;height:auto;width:100%;object-fit:cover; }
  .pj-h3{
    font-family:'Clash Display',sans-serif;font-weight:600;
    font-size:clamp(24px,3vw,38px);line-height:1.05;letter-spacing:-.02em;color:var(--ink);margin:0 0 16px;
  }
  /* Video */
  .pj-video{ width:100%;border-radius:10px;overflow:hidden;background:var(--paper-2); }
  .pj-video video{ width:100%;display:block;aspect-ratio:16/10;object-fit:cover; }
  .pj-ph-video{ aspect-ratio:16/10;border-radius:10px; }
  /* Text block: eyebrow left, title+body right (2/3) */
  .pj-textblock-grid{ display:grid;grid-template-columns:1fr 2fr;gap:clamp(24px,5vw,80px);align-items:start; }
  .pj-textblock-title{
    font-family:'Clash Display',sans-serif;font-weight:600;
    font-size:clamp(24px,3.2vw,42px);line-height:1.05;letter-spacing:-.025em;color:var(--ink);margin:0 0 18px;
  }
  /* Slider (bento, like About studio strip) */
  .pj-slider-head{ display:flex;align-items:flex-end;justify-content:space-between;gap:20px;margin-bottom:24px; }
  .pj-slider-head .pj-block-title{ margin:0; }
  .pj-slider-nav{ display:flex;gap:10px; }
  .pj-slider-track{
    display:flex;gap:clamp(16px,2vw,28px);padding-left:var(--pj-edge);
    scroll-padding-left:var(--pj-edge);
    overflow-x:auto;scroll-behavior:smooth;scroll-snap-type:x mandatory;
    -ms-overflow-style:none;scrollbar-width:none;
  }
  .pj-slider-track::-webkit-scrollbar{ display:none; }
  .pj-slide{
    flex:0 0 auto;
    width:clamp(300px,34vw,440px);
    margin:0;scroll-snap-align:start;
  }
  .pj-slide:last-child{ margin-right:var(--pj-edge); }
  .pj-slide img,.pj-slide-ph{ width:100%;aspect-ratio:4/5;object-fit:cover;border-radius:10px;display:block; }
  .pj-slide .pj-cap{ margin-top:10px; }
  @media(max-width:760px){
    .pj-imagetext-grid{ grid-template-columns:1fr;gap:24px; }
    .pj-imagetext.is-right .pj-imagetext-media{ order:0; }
    .pj-textblock-grid{ grid-template-columns:1fr;gap:16px; }
    .pj-slider-nav{ display:none; }
    .pj-twoup .pj-fig img,.pj-twoup .pj-ph{ height:auto;aspect-ratio:4/5; }
    .pj-stack-item img,.pj-stack-item .pj-ph{ aspect-ratio:4/5; }
    .pj-slide{ height:auto;width:clamp(220px,72vw,320px); }
    .pj-slide img,.pj-slide-ph{ aspect-ratio:4/5; }
  }
  html.lenis,html.lenis body{height:auto;}
  .lenis.lenis-smooth{scroll-behavior:auto!important;}
  .lenis.lenis-smooth [data-lenis-prevent]{overscroll-behavior:contain;}
  .lenis.lenis-stopped{overflow:hidden;}

  /* preloader */
  .preloader{
    position:fixed;inset:0;z-index:9999;background:var(--paper);
    display:flex;align-items:center;justify-content:center;
    transition:opacity .6s ease,visibility .6s ease;
  }
  .preloader-mark{height:34px;width:auto;color:var(--blue);
    animation:markPulse 1.4s ease-in-out infinite;}
  @keyframes markPulse{0%,100%{opacity:.35;}50%{opacity:1;}}
  body.loaded .preloader{opacity:0;visibility:hidden;}
  ::selection{background:var(--blue);color:#fff;}
  body{
    background:var(--paper);color:var(--ink);
    font-family:'Switzer',sans-serif;
    -webkit-font-smoothing:antialiased;
    overflow-x:hidden;
  }
  a{color:inherit;text-decoration:none;}

  /* ---------- nav ---------- */
  header{
    position:fixed;top:0;left:0;right:0;z-index:100;
    display:flex;align-items:center;justify-content:space-between;
    padding:22px clamp(20px,5vw,64px);
    color:var(--header-fg, #0c0c12);
    transition:color .4s ease;
  }
  body[data-header="dark"]{ --header-fg:#fff; }
  body[data-header="light"]{ --header-fg:#0c0c12; }
  body.menu-open{ --header-fg:#0c0c12 !important; }
  body.menu-closing{ --header-fg:#0c0c12 !important; }
  html[data-arriving] body{ --header-fg:#fff !important; }
  html[data-arriving] .dot-btn{ transition:none !important; }
  .logo{
    font-family:'Clash Display',sans-serif;font-weight:600;
    font-size:18px;letter-spacing:-.01em;color:var(--header-fg,#0c0c12);
    display:flex;align-items:center;gap:9px;
  }
  .logo .mark{height:16px;width:auto;display:inline-block;color:inherit;}
  .logo-short{display:none;}
  body.scrolled .logo-full{display:none;}
  body.scrolled .logo-short{display:inline;}
  nav{display:flex;gap:30px;align-items:center;}
  nav a{
    font-size:14px;font-weight:500;color:var(--header-fg,#0c0c12);letter-spacing:.01em;
    position:relative;display:inline-flex;align-items:center;
    transition:opacity .25s ease,color .4s ease;
  }
  nav a:hover{opacity:.55;}
  .nav-cta{
    margin-right:-18px;
    color:var(--header-fg,#0c0c12) !important;border:1px solid var(--header-fg,#0c0c12) !important;
  }
  /* burger as a fixed dot */
  .burger{
    display:none;align-items:center;justify-content:center;
    width:40px;height:40px;cursor:pointer;background:none;border:none;padding:0;
    position:fixed;top:12px;right:clamp(8px,3vw,28px);z-index:110;
  }
  .burger .dot-btn{
    width:16px;height:16px;border-radius:50%;background:var(--header-fg,#0c0c12);
    transition:transform .3s ease;
  }
  body.pj-transitioning .dot-btn{ transition:none !important; }
  .burger:hover .dot-btn{transform:scale(1.18);}

  /* circular reveal overlay */
  .mobile-menu{
    position:fixed;top:0;left:0;right:0;bottom:0;height:100dvh;z-index:95;
    display:flex;flex-direction:column;justify-content:center;
    padding:0 clamp(28px,10vw,64px);
    visibility:hidden;overflow:hidden;
    transition:visibility .8s;
  }
  body.menu-open{overflow:hidden;}
  .mobile-menu::before{
    content:'';position:fixed;
    top:16px;right:clamp(8px,3vw,28px);
    width:16px;height:16px;border-radius:50%;
    background:#e7e8ea;
    transform:scale(0);transform-origin:center;
    transition:transform .7s cubic-bezier(.76,0,.24,1);
    z-index:0;
  }
  .mobile-menu a{position:relative;z-index:1;}
  body.menu-open .mobile-menu{visibility:visible;}
  body.menu-open .mobile-menu::before{transform:scale(280);}
  .mobile-menu a{
    font-family:'Clash Display',sans-serif;font-weight:500;color:var(--ink);
    font-size:clamp(38px,11vw,68px);letter-spacing:-.02em;line-height:1.25;
    text-decoration:none;
    opacity:0;transform:translateY(40px);
    transition:opacity .1s,transform .1s;
  }
  body.menu-open .mobile-menu a{
    opacity:1;transform:translateY(0);
    transition:opacity .6s cubic-bezier(.2,.7,.2,1),transform .7s cubic-bezier(.2,.7,.2,1);
  }
  body.menu-open .mobile-menu a:nth-child(1){transition-delay:.5s;}
  body.menu-open .mobile-menu a:nth-child(2){transition-delay:.58s;}
  body.menu-open .mobile-menu a:nth-child(3){transition-delay:.66s;}
  body.menu-open .mobile-menu a:nth-child(4){transition-delay:.74s;}
  .mobile-menu a:active,.mobile-menu a:hover{color:var(--blue);}
  .mobile-menu a.m-cta{
    color:var(--ink);margin-top:0;
  }
  .mobile-menu a.m-cta:active,.mobile-menu a.m-cta:hover{color:var(--blue);}

  @media(max-width:720px){
    :root{--section-gap:64px;}
    nav .nav-link, nav .nav-cta{display:none;}
    .burger{display:flex;}
  }

  /* ---------- reveal animation ---------- */
  .reveal{opacity:0;transform:translateY(24px);animation:rise .9s cubic-bezier(.2,.7,.2,1) forwards;}
  @keyframes rise{to{opacity:1;transform:translateY(0);}}
  .d1{animation-delay:.05s;} .d2{animation-delay:.18s;} .d3{animation-delay:.31s;}
  .d4{animation-delay:.44s;} .d5{animation-delay:.57s;} .d6{animation-delay:.7s;}

  .scroll-reveal{opacity:0;transform:translateY(40px);transition:opacity 1s cubic-bezier(.2,.7,.2,1),transform 1s cubic-bezier(.2,.7,.2,1);}
  .scroll-reveal.in{opacity:1;transform:translateY(0);}
  .reveal-item{opacity:0;transform:translateY(38px);transition:opacity .9s cubic-bezier(.2,.7,.2,1),transform .9s cubic-bezier(.2,.7,.2,1);}
  .reveal-item.in{opacity:1;transform:translateY(0);}

  /* ---------- hero ---------- */
  .hero{
    min-height:78vh;display:flex;flex-direction:column;justify-content:flex-start;
    padding:clamp(150px,26vh,300px) clamp(20px,5vw,64px) clamp(40px,6vh,70px);
    max-width:var(--maxw);margin:0 auto;position:relative;
  }
  h1{
    font-family:'Clash Display',sans-serif;font-weight:600;
    font-size:clamp(64px,16vw,260px);line-height:.9;letter-spacing:-.035em;
  }
  h1 em{font-style:normal;color:var(--blue);}
  .rotator{
    display:block;line-height:.9;
    transition:color .35s ease;
  }
  .rotator.fade-out{color:var(--paper);}
  .hero-sub{
    font-family:'Switzer',sans-serif;font-weight:500;
    font-size:clamp(17px,2vw,22px);line-height:1.5;max-width:var(--measure-text);
    margin-top:36px;color:#28282e;
  }

  /* ---------- belief / pov ---------- */
  .pov{
    position:relative;
  }
  .pov-inner{
    position:relative;z-index:1;
    padding:var(--section-gap) var(--gutter);
    max-width:var(--maxw);margin:0 auto;
  }
  .pov-stage{position:relative;}
  /* unified slash label */
  .label{
    display:block;font-family:'Switzer',sans-serif;font-size:13px;font-weight:600;
    letter-spacing:.14em;text-transform:uppercase;color:var(--muted);margin-bottom:40px;
  }
  .pov-text{
    font-family:'Erode',serif;font-weight:400;
    font-size:clamp(28px,4.6vw,62px);line-height:1.18;letter-spacing:-.01em;
    max-width:var(--measure-wide);
  }
  .pov-text .kw{
    color:var(--blue);font-weight:500;font-style:normal;
    position:relative;display:inline-block;
  }
  /* staggered keyword entrance */
  .pov-text.in .kw{animation:kwPop .7s cubic-bezier(.2,.7,.2,1) backwards;}
  .pov-text.in .kw:nth-of-type(1){animation-delay:.25s;}
  .pov-text.in .kw:nth-of-type(2){animation-delay:.42s;}
  .pov-text.in .kw:nth-of-type(3){animation-delay:.59s;}
  @keyframes kwPop{
    0%{color:var(--ink);opacity:.55;}
    100%{color:var(--blue);opacity:1;}
  }
  /* explanation panel on keyword hover (desktop) */
  .pov-panel{
    position:absolute;inset:0;z-index:5;
    background:#E6E6FE;border-radius:14px;
    padding:clamp(28px,4vw,52px);
    display:flex;flex-direction:column;justify-content:center;gap:14px;
    opacity:0;visibility:hidden;transform:scale(.985);
    transition:opacity .4s cubic-bezier(.2,.7,.2,1),transform .4s cubic-bezier(.2,.7,.2,1),visibility .4s;
    pointer-events:none;
  }
  .pov-panel.show{opacity:1;visibility:visible;transform:scale(1);}
  .pov-panel-word{
    font-family:'Clash Display',sans-serif;font-weight:600;color:var(--blue);
    font-size:clamp(34px,5vw,72px);letter-spacing:-.025em;line-height:1;
  }
  .pov-panel-desc{
    font-family:'Erode',serif;color:var(--blue);
    font-size:clamp(17px,1.7vw,24px);line-height:1.4;max-width:none;
  }
  .pov-tail{
    font-family:'Switzer',sans-serif;font-size:clamp(16px,1.6vw,18px);
    color:var(--muted);margin-top:34px;max-width:var(--measure-text);line-height:1.6;
  }
  .pov-btn{margin-top:30px;}

  /* ---------- showcase video ---------- */
  .showcase{
    width:100%;height:clamp(60vh,82vh,900px);
    background:#0c0c12;
    position:relative;overflow:hidden;
  }
  .showcase video{
    position:absolute;inset:0;width:100%;height:100%;
    object-fit:cover;object-position:center;display:block;cursor:pointer;
  }
  .sound-toggle{
    position:absolute;bottom:24px;right:24px;z-index:4;
    width:50px;height:50px;border-radius:50%;
    border:1.5px solid rgba(255,255,255,.45);background:rgba(0,0,0,.25);
    display:flex;align-items:center;justify-content:center;cursor:pointer;
    backdrop-filter:blur(6px);transition:all .3s ease;
  }
  .sound-toggle svg{width:20px;height:20px;fill:#fff;transition:fill .3s;}
  @media(hover:hover){
    .sound-toggle:hover{background:#fff;border-color:#fff;}
    .sound-toggle:hover svg{fill:var(--ink);}
  }
  @media(max-width:720px){
    .showcase{height:100vh;}
    .pov-panel{display:none !important;}
    .pov-text .kw{pointer-events:none;}
  }

  /* ---------- what we do strip (bold vertical) ---------- */
  .strip{
    padding:var(--section-gap) var(--gutter);
    max-width:var(--maxw);margin:0 auto;
  }
  .strip-list{display:flex;flex-direction:column;}
  .strip-btn{margin-top:clamp(32px,5vh,56px);}
  .strip-row{
    display:flex;align-items:baseline;gap:clamp(14px,2vw,28px);
    padding:clamp(10px,1.6vh,18px) 0;
    border-top:1px solid var(--line);
    color:var(--ink);transition:color .3s ease,padding-left .4s cubic-bezier(.2,.7,.2,1);
    cursor:pointer;text-decoration:none;
  }
  .strip-row:last-child{border-bottom:1px solid var(--line);}
  .strip-row .num{
    font-family:'Switzer',sans-serif;font-weight:600;font-size:14px;
    color:var(--muted);min-width:40px;transition:color .3s ease;
  }
  .strip-row .name{
    font-family:'Clash Display',sans-serif;font-weight:600;
    font-size:clamp(34px,7vw,92px);letter-spacing:-.025em;line-height:1;
  }
  .strip-row:hover{color:var(--blue);padding-left:clamp(8px,1.5vw,24px);}
  .strip-row:hover .num{color:var(--blue);}

  /* ---------- featured work ---------- */
  .featured{
    padding:var(--section-gap) var(--gutter);
    max-width:var(--maxw);margin:0 auto;
  }
  .featured-head{
    display:flex;justify-content:space-between;align-items:center;
    flex-wrap:wrap;gap:16px;margin-bottom:48px;
  }
  /* unified text link with arrow */
  .text-link{
    display:inline-flex;align-items:center;gap:8px;
    font-family:'Switzer',sans-serif;font-weight:600;font-size:15px;color:var(--ink);
    text-decoration:none;transition:color .25s ease;cursor:pointer;
  }
  .text-link svg{
    width:14px;height:14px;fill:none;stroke:currentColor;stroke-width:2;
    transition:transform .25s ease;
  }
  .text-link:hover{color:var(--blue);}
  .text-link:hover svg{transform:translate(3px,-3px);}

  /* feature project: image left (4/5), text right */
  .work-feature{
    display:grid;grid-template-columns:5fr 4fr;gap:clamp(32px,5vw,72px);
    align-items:center;margin-bottom:clamp(16px,2vw,28px);
    background:#f5f5f7;border-radius:16px;
    padding:clamp(32px,4vw,56px);
  }
  .feature-card{display:block;cursor:pointer;}
  .feature-text{max-width:560px;}
  .feature-services{
    font-family:'Switzer',sans-serif;font-size:13px;font-weight:600;
    letter-spacing:.06em;color:var(--blue);margin-bottom:20px;
  }
  .feature-name{
    font-family:'Clash Display',sans-serif;font-weight:600;
    font-size:clamp(34px,4.5vw,64px);letter-spacing:-.025em;line-height:1;margin-bottom:20px;
    transition:color .25s ease;
  }
  .work-feature:has(.feature-card:hover) .feature-name{color:var(--blue);}
  .feature-card:hover .work-thumb{border-radius:42px;}
  .feature-desc{
    font-family:'Erode',serif;font-size:clamp(16px,1.4vw,19px);
    line-height:1.55;color:#33333a;margin-bottom:24px;
  }

  .work-grid{
    display:grid;grid-template-columns:repeat(3,1fr);gap:clamp(16px,2vw,28px);
  }
  .work-card{display:block;cursor:pointer;}
  .work-thumb{
    aspect-ratio:4/5;border-radius:10px;overflow:hidden;background:var(--paper-2);
    position:relative;
    transition:border-radius .28s cubic-bezier(.22,1,.36,1);
  }
  .work-thumb img{
    width:100%;height:100%;object-fit:cover;display:block;
  }
  .work-card:hover .work-thumb{border-radius:42px;}
  .work-meta{margin-top:16px;}
  .work-name{
    font-family:'Clash Display',sans-serif;font-weight:600;
    font-size:clamp(18px,1.6vw,22px);letter-spacing:-.02em;
    transition:color .25s ease;
  }
  .work-card:hover .work-name{color:var(--blue);}
  .work-line{
    font-family:'Erode',serif;font-size:15px;color:var(--muted);
    margin-top:4px;line-height:1.4;
  }
  .feature-mobile-meta{display:none;}
  @media(max-width:720px){
    .work-grid{grid-template-columns:1fr;gap:36px;}
    .work-thumb{aspect-ratio:4/5;}
    .work-feature{display:block;margin-bottom:36px;background:none;padding:0;border-radius:0;}
    .feature-card{max-width:none;}
    .feature-text{display:none;}
    .feature-mobile-meta{display:block;}
  }

  /* ---------- close / CTA ---------- */
  .close{
    padding:clamp(90px,16vh,180px) clamp(20px,5vw,64px);
    max-width:var(--maxw);margin:0 auto;text-align:center;
  }
  .close h2{
    font-family:'Clash Display',sans-serif;font-weight:600;
    font-size:clamp(34px,6vw,86px);line-height:1.02;letter-spacing:-.025em;
    max-width:900px;margin:0 auto;
  }
  .close h2 em{font-style:normal;color:var(--blue);}
  .foot-cta{margin-top:40px;}
  /* ---------- reusable buttons ---------- */
  .btn-fill{
    display:inline-flex;align-items:center;gap:9px;
    font-family:'Switzer',sans-serif;font-weight:600;font-size:14px;color:#fff;
    background:var(--ink);padding:13px 26px;border-radius:999px;
    text-decoration:none;transition:background .25s ease;cursor:pointer;
  }
  .btn-fill:hover{background:var(--blue);}
  .btn-fill svg{width:14px;height:14px;fill:none;stroke:#fff;stroke-width:2;transition:transform .25s;}
  .btn-fill:hover svg{transform:translate(3px,-3px);}
  .btn-outline{
