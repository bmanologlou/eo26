---
const steps = [
  { name: "Discovery", desc: "We dig into who you are, what you stand for, and what the world around you needs. Clarity starts with listening." },
  { name: "Strategy", desc: "We turn insight into direction: a purpose, a position, and a story that gives every decision a reason." },
  { name: "Activation", desc: "We bring the brand to life across identity, design, and experience, then set it loose to grow." },
];
---
<section class="method" id="method">
  <div class="method-inner">
    <span class="label scroll-reveal">/How We Work</span>
    <div class="method-list" data-stagger>
      {steps.map((s) => (
        <div class="mrow reveal-item">
          <h3 class="mrow-name">{s.name}</h3>
          <p class="mrow-desc">{s.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>
