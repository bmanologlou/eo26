---
// Full-page website screenshot — shows top 80vh, expands to full height on click.
const { src, alt = "", title, linkText = "View full page" } = Astro.props;
const id = "fp-" + Math.random().toString(36).slice(2, 8);
---
<section class="pj-block pj-fullpage" data-fullpage>
  <div class="pj-inner">
    <div class="pj-fullpage-head">
      {title && <h3 class="pj-block-title">{title}</h3>}
      <button class="pj-fullpage-toggle" data-fullpage-toggle aria-expanded="false" aria-controls={id}>
        <span class="fp-label-more">{linkText}</span>
        <span class="fp-label-less">Show less</span>
      </button>
    </div>
    <div class="pj-fullpage-viewport" id={id} data-fullpage-viewport>
      {src
        ? <img src={src} alt={alt} />
        : <div class="pj-fullpage-ph"><span>Full page</span></div>}
    </div>
  </div>
</section>
