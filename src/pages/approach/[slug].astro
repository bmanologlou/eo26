---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Cta from '../../components/Cta.astro';
import Footer from '../../components/Footer.astro';
import { pillars, getPillar } from '../../data/pillars.js';

export function getStaticPaths() {
  return pillars.map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const pillar = getPillar(slug);
const idx = pillars.findIndex((p) => p.slug === slug);
const next = pillars[(idx + 1) % pillars.length];
---

<Base title={`${pillar.name} — Approach — Eternal Optimists`} description={pillar.lead.slice(0, 155)}>
  <Header />

  <main class="pl">
    <div class="pl-top">
      <div class="pl-top-content">
        <span class="label scroll-reveal">/The Six Pillars</span>
        <h1 class="pl-toptitle scroll-reveal">The building blocks of a modern brand</h1>
        <p class="pl-topintro scroll-reveal">Our six pillars describe how a brand is created, evolved and grown. Each one contributes essential elements to a brand's development, from the foundation it stands on to the momentum that keeps it moving. Together they form a complete approach; individually, each solves a distinct part of the puzzle.</p>
      </div>
    </div>
    <div class="pl-inner">
      <aside class="pl-nav">
        <span class="label">/Pillars</span>
        <ul>
          {pillars.map((p) => (
            <li>
              <a href={`/approach/${p.slug}`} class={p.slug === slug ? "is-current" : ""}>{p.name}</a>
            </li>
          ))}
        </ul>
      </aside>

      <article class="pl-body">
        <span class="label pl-eyebrow scroll-reveal">/{pillar.name}</span>
        <div class="pl-intro-group" data-stagger>
          <h2 class="pl-question reveal-item">{pillar.question}</h2>
          <p class="pl-lead reveal-item">{pillar.lead}</p>
        </div>

        <div class="pl-section scroll-reveal">
          <h3 class="pl-h2">{pillar.benefitTitle}</h3>
          <p class="pl-text">{pillar.benefit}</p>
        </div>

        <div class="pl-section scroll-reveal">
          <h3 class="pl-h2">What it can include</h3>
          <ul class="pl-services">
            {pillar.services.map((s) => <li>{s}</li>)}
          </ul>
        </div>

        <a href={`/approach/${next.slug}`} class="pl-next scroll-reveal">
          <span class="pl-next-label">Next pillar</span>
          <span class="pl-next-row">
            <span class="pl-next-name">{next.name}</span>
            <span class="pl-next-arrow" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </span>
          </span>
        </a>
      </article>
    </div>
  </main>

  <Cta />
  <Footer />
  <script is:inline defer src="/main.js"></script>
</Base>

<style is:global>
  body.pillar-page{ background:#EEEEFE; }
  body.pillar-page .cta-close, body.pillar-page footer{ background:#EEEEFE; }
</style>
<script is:inline>
  (function(){
    const apply = ()=>{ if(document.querySelector('.pl')) document.body.classList.add('pillar-page'); else document.body.classList.remove('pillar-page'); };
    apply();
    document.addEventListener('astro:page-load', apply);
    document.addEventListener('astro:after-swap', apply);
  })();
</script>
